# Copy to .env.local (web) or .env (api) and fill in. Never commit real values.

# Web
# The address of the API. The web server calls it from the server side; the browser never sees it.
API_URL=http://localhost:4000

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google sign-in button: the same OAuth Client ID the API has as GOOGLE_CLIENT_ID. Empty hides the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# The public address of the site, for the sitemap and share previews (e.g. https://novera.example)
NEXT_PUBLIC_SITE_URL=
# Analytics (a cookieless tool such as Umami), loaded only after the visitor accepts. Leave both empty to switch it off.
# The address of the tool's script and the id it gives this site.
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=
# 1 = show sample branches and cars instead of calling the API. For local work and tests only: the production
# build and a Vercel production deployment refuse to start with it set. Leave it empty on any real site.
USE_MOCKS=
# Set to 1 only by test runs (CI, Playwright) that build or serve the production bundle with sample data. Never on Vercel.
NOVERA_E2E=

# API
# The API counts as production unless this is "development" (or "test"). Put development in apps/api/.env for local work;
# do NOT put it in the web's .env.local. Without it the API wants the production settings below (API_ACCESS_KEY, WEB_URL https).
NODE_ENV=development
DATABASE_URL="postgresql://novera:novera_dev@localhost:5432/novera?schema=public"
# The web app uses 3000, so the API runs on 4000
PORT=4000
POSTGRES_USER=novera
POSTGRES_PASSWORD=novera_dev
POSTGRES_DB=novera
# The public address of the site, used in password reset links. In production it must start with https://
WEB_URL=
RATES_API_URL=
# How many proxies in front of the API add their own X-Forwarded-For entry (the web server counts as one).
# Empty means 1. Use 0 only if the API is reached directly. See docs/SECURITY.md.
TRUST_PROXY_HOPS=
# The secret the web server sends with every call to the API (X-Novera-Key). In production the API does not start
# without it, so set the SAME value in both (Render makes it; copy it to Vercel). At least 32 characters.
# Leave empty in development: the API is then open.
API_ACCESS_KEY=
# Password reset e-mail through Resend (https://resend.com). Leave both empty to send no e-mail:
# the link is then written to the log in development and nowhere in production.
RESEND_API_KEY=
# The sender, e.g. Novera Mobility <noreply@your-domain>. The domain must be verified in Resend.
MAIL_FROM=
# Google sign-in: the OAuth Client ID (Google Cloud Console, type Web application), e.g. 123-abc.apps.googleusercontent.com.
# Not a secret. The web app needs the SAME value as NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave empty to switch Google sign-in off.
GOOGLE_CLIENT_ID=
# Set to 1 to keep the Swagger page (/docs) on in production. Leave empty to switch it off there.
ENABLE_DOCS=
# The address the API listens on. In production set it to a private address so only the web server can reach it.
HOST=