generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enum'lar ----------

enum Locale {
  TR
  EN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum Currency {
  TRY
  EUR
  USD
}

enum AccountType {
  INDIVIDUAL
  CORPORATE
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum ConsumptionUnit {
  L_PER_100KM
  KWH_PER_100KM
}

enum ExtraPricing {
  PER_DAY
  FIXED
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

enum FaqAudience {
  INDIVIDUAL
  CORPORATE
}

enum FaqTopic {
  rezervasyon
  odeme
  teslim
  hasar
  hesap
  kurumsal
}

enum QuoteStatus {
  RECEIVED
  IN_REVIEW
  OFFERED
}

// ---------- Hesap ----------

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  accountType  AccountType @default(INDIVIDUAL)

  // Kurumsal hesap bilgileri (yalnızca CORPORATE hesapta dolu gelir, hesabı Novera açar)
  companyName  String?
  taxOffice    String?
  companyCity  String?
  companyPhone String?
  contactTitle String?
  salesContact Json? // { "name": "...", "email": "...", "phone": "..." }

  locale    Locale   @default(TR)
  theme     Theme    @default(LIGHT)
  currency  Currency @default(TRY)
  // E-posta tercihleri (SPEC §2.9): seyahat öncesi hatırlatma varsayılan açık, kampanya varsayılan kapalı (pazarlama için onay gerekir)
  notifyReminders Boolean @default(true)
  notifyCampaigns Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations      Reservation[]
  quoteRequests     QuoteRequest[]
  pointTransactions PointTransaction[]
  sessions          Session[]
  passwordResetTokens   PasswordResetToken[]
}

// Giriş oturumu (BACKLOG #34). Çerezdeki rastgele anahtarın yalnızca SHA-256 özeti saklanır.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String? // girişte tarayıcının bildirdiği; "açık oturumlar" listesinde cihaz adı için
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Single-use password reset link (BACKLOG #27, issue #36). Only the SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Puan kazanımı. Bakiye = bu kayıtların toplamı. Puanla ödeme v1'de yok.
model PointTransaction {
  id        String   @id @default(uuid())
  points    Int
  createdAt DateTime @default(now())

  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ---------- Bayi ve araç ----------

model Branch {
  id           String @id @default(uuid())
  name         String
  city         String
  address      String
  latitude     Float
  longitude    Float
  phone        String
  email        String
  openingHours Json

  vehicles       Vehicle[]
  pickupBookings Reservation[] @relation("PickupBranch")
  returnBookings Reservation[] @relation("ReturnBranch")

  @@index([city])
}

model VehicleClass {
  id     String @id @default(uuid())
  slug   String @unique
  nameTr String
  nameEn String

  models VehicleModel[]
}

// Katalogdaki model (Araçlarımız sayfası). Fiyat ve özellikler burada.
model VehicleModel {
  id              String          @id @default(uuid())
  slug            String          @unique
  brand           String
  model           String
  seats           Int
  bags            Int
  transmission    Transmission
  fuelType        FuelType
  consumption     Float
  consumptionUnit ConsumptionUnit
  dailyPrice      Int // TRY, kuruş cinsinden (₺1.250 = 125000)
  description     Json // { "tr": "...", "en": "..." }
  imageUrl        String?

  classId String
  class   VehicleClass @relation(fields: [classId], references: [id])

  vehicles Vehicle[]

  @@index([classId])
}

// Bir bayide duran fiziksel araç. Müsaitlik bu tabloya göre hesaplanır.
model Vehicle {
  id     String  @id @default(uuid())
  plate  String  @unique
  year   Int
  active Boolean @default(true)

  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])

  reservations Reservation[]
  holds        Hold[]

  @@index([vehicleModelId])
  @@index([branchId])
}

model Extra {
  id      String       @id @default(uuid())
  slug    String       @unique
  nameTr  String
  nameEn  String
  price   Int // TRY, kuruş cinsinden
  pricing ExtraPricing

  reservationExtras ReservationExtra[]
}

// ---------- Rezervasyon ----------

// "Kirala"da aracı 15 dakika tutar. Süre dolunca araç serbest kalır;
// tutulan araç başka aramada müsait görünmez (BACKLOG Y48).
model Hold {
  id             String   @id @default(uuid())
  startAt        DateTime
  endAt          DateTime
  pickupBranchId String
  returnBranchId String
  expiresAt      DateTime
  clientKey      String?
  createdAt      DateTime @default(now())

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startAt, endAt])
  @@index([expiresAt])
  @@index([clientKey, expiresAt])
}

model Reservation {
  id      String            @id @default(uuid())
  number  String            @unique // ör. NVR-2026-00123
  status  ReservationStatus @default(CONFIRMED)
  startAt DateTime
  endAt   DateTime
  days    Int
  pointsUsed        Int      @default(0) // puanla ödenen kısım (1 puan = ₺5, yalnızca TRY); iptalde iade sayılır
  // Kampanya kodu: kod ve yüzde, rezervasyon anındaki haliyle saklanır (kod sonradan değişse de bu rezervasyon aynı kalır).
  promoCode         String?
  promoPercent      Int?
  discountAmount    Int      @default(0) // kodun düştüğü tutar, `currency` biriminin alt biriminde

  // Aşağıdaki tüm tutarlar `currency` biriminin alt biriminde (kuruş/cent) saklanır.
  // Birim fiyatlar önce çevrilir, sonra günle çarpılır: kalemlerin toplamı = totalPrice.
  currency          Currency @default(TRY)
  exchangeRate      Decimal  @default(1) @db.Decimal(18, 8) // rezervasyon anındaki kur (1 TRY = ? currency)
  vehicleDailyPrice Int
  totalPrice        Int

  createdAt DateTime @default(now())

  // Hesap silinince rezervasyon kalır, kullanıcı bağlantısı boşalır
  userId         String?
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicleId      String
  vehicle        Vehicle @relation(fields: [vehicleId], references: [id])
  pickupBranchId String
  pickupBranch   Branch  @relation("PickupBranch", fields: [pickupBranchId], references: [id])
  returnBranchId String
  returnBranch   Branch  @relation("ReturnBranch", fields: [returnBranchId], references: [id])

  extras           ReservationExtra[]
  pointTransaction PointTransaction?

  @@index([vehicleId, startAt, endAt])
  @@index([userId])
}

// Kampanya kodları (SPEC §2.3): araç ve ek hizmetlerin toplamından yüzde olarak düşer.
// Kod büyük harfle saklanır; aranırken de büyük harfe çevrilir.
model PromoCode {
  id         String    @id @default(uuid())
  code       String    @unique
  percent    Int // 1-90 arası tam sayı (tohum ve test bunu korur)
  active     Boolean   @default(true)
  validFrom  DateTime? // boşsa hemen geçerli
  validUntil DateTime? // boşsa süresiz
}

model ReservationExtra {
  id         String @id @default(uuid())
  quantity   Int    @default(1)
  unitPrice  Int // rezervasyon anındaki fiyat, rezervasyonun para biriminde
  totalPrice Int

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  extraId       String
  extra         Extra       @relation(fields: [extraId], references: [id])

  @@unique([reservationId, extraId])
}

// ---------- İçerik ve formlar ----------

// SPEC Ek A: Konsept, Ne Alıyorsunuz?, Teknolojik Artısı
model Product {
  id           String  @id @default(uuid())
  slug         String  @unique // ör. akilli-kurumsal-filo
  title        Json // { "tr": "...", "en": "..." }
  concept      Json
  whatYouGet   Json
  techBenefits Json // { "tr": ["..."], "en": ["..."] }
  featured     Boolean @default(false) // "En çok tercih edilen"
  sortOrder    Int     @default(0)

  quotes QuoteRequest[]
}

model Service {
  id        String @id @default(uuid())
  slug      String @unique // navbar menüsünde hizmetler sayfasındaki madde için
  title     Json
  summary   Json // tek cümlelik açıklama
  points    Json // { "tr": ["...", "...", "..."], "en": [...] }
  sortOrder Int    @default(0)
}

model FaqItem {
  id        String      @id @default(uuid())
  audience  FaqAudience
  topic     FaqTopic    @default(rezervasyon)
  question  Json // { "tr": "...", "en": "..." }
  answer    Json
  sortOrder Int         @default(0)

  @@index([audience])
  @@index([topic])
}

// Kurumsal teklif talepleri (GET /me/quotes ve POST /quotes)
model QuoteRequest {
  id             String      @id @default(uuid())
  number         String      @unique // ör. TKL-2026-00042
  status         QuoteStatus @default(RECEIVED)
  companyName    String
  contactName    String?
  phone          String?
  vehicleCount   Int
  durationMonths Int
  vehicleType    String
  deliveryCities String?
  notes          String?
  email          String
  kvkkConsentAt  DateTime    @default(now())
  createdAt      DateTime    @default(now())

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model ContactMessage {
  id            String   @id @default(uuid())
  name          String
  email         String
  phone         String?
  subject       String
  message       String
  kvkkConsentAt DateTime
  createdAt     DateTime @default(now())
}

model ExchangeRate {
  currency   Currency @id
  ratePerTry Decimal  @db.Decimal(18, 8) // 1 TRY kaç `currency` ediyor
  updatedAt  DateTime @updatedAt
}