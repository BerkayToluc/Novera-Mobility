generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enum'lar ----------

enum Locale {
  TR
  EN
}

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum Currency {
  TRY
  EUR
  USD
}

enum AccountType {
  INDIVIDUAL
  CORPORATE
}

// Panel yetkisi (V2-23, ADR-24); hesap türünden (AccountType) ayrıdır. Yalnızca `pnpm admin:create` ADMIN verir.
enum Role {
  CUSTOMER
  ADMIN
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
}

enum ConsumptionUnit {
  L_PER_100KM
  KWH_PER_100KM
}

enum ExtraPricing {
  PER_DAY
  FIXED
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

// RECEIVED → IN_REVIEW → OFFERED → CLOSED: ileri atlama serbest, geri gidiş yok (V2-32).
enum QuoteStatus {
  RECEIVED
  IN_REVIEW
  OFFERED
  CLOSED
}

// Teklifin nereden geldiği: sitedeki form ya da Filom'daki sözleşme yenileme talebi (V2-38).
enum QuoteSource {
  WEB
  FLEET_RENEWAL
}

// ---------- Hesap ----------

// Şifre belirleme bağlantısının ne için olduğu: unutulan şifre (1 saat) ya da kurumsal davet (7 gün, V2-33).
enum ResetTokenKind {
  RESET
  INVITE
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  // Boş: hesap yalnızca Google ile açılmış, parola henüz belirlenmemiş (şifre sıfırlama ile belirlenir)
  passwordHash String?
  // Google hesabının değişmez kimliği (ID token `sub`); e-posta değişse de aynı kalır
  googleSub    String?     @unique
  firstName    String
  lastName     String
  accountType  AccountType @default(INDIVIDUAL)
  role         Role        @default(CUSTOMER)

  // Kurumsal hesap bir şirkete bağlıdır (V2-33). Şirket bilgisi `Company`'dedir; `GET /me` cevabı onu oradan doldurur.
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Kişinin ünvanı (davette yazılır); şirketin değil kişinin bilgisidir.
  contactTitle String?

  // Hesap kapatma (V2-34): doluysa hesap giremez (parola ve Google), oturumları silinmiştir. Hesap silinmez; yönetici yeniden açabilir.
  disabledAt   DateTime?

  locale    Locale   @default(TR)
  theme     Theme    @default(LIGHT)
  currency  Currency @default(TRY)
  // E-posta tercihleri (SPEC §2.9): seyahat öncesi hatırlatma varsayılan açık, kampanya varsayılan kapalı (pazarlama için onay gerekir)
  notifyReminders Boolean @default(true)
  notifyCampaigns Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations      Reservation[]       @relation("ReservationOwner")
  // Rezervasyonlar, bu hesabın (yönetici) panelden iptal ettikleri (V2-31).
  cancelledReservations Reservation[]   @relation("ReservationCanceller")
  // İletişim mesajları, bu hesabın (yönetici) "ele alındı" dediği (V2-32).
  handledMessages       ContactMessage[] @relation("MessageHandler")
  quoteRequests     QuoteRequest[]
  // Filom'dan açtığı servis talepleri (V2-41); hesap silinince talep kalır, açan kişi boşalır.
  serviceRequests   ServiceRequest[]
  pointTransactions PointTransaction[]
  sessions          Session[]
  passwordResetTokens   PasswordResetToken[]

  // Bir şirketin kullanıcıları (V2-33).
  @@index([companyId])
}

// Şirket (V2-33, ADR-25): kurumsal müşteri. Kurumsal hesaplar `User.companyId` ile buna bağlanır; bir şirketin birden çok
// kullanıcısı olabilir. Şirketi ve kullanıcılarını Novera açar (davet): müşteri kendi başına hesap açamaz.
model Company {
  id           String   @id @default(uuid())
  name         String   @unique
  taxOffice    String?
  city         String?
  phone        String?
  // { "name": "...", "email": "...", "phone": "..." } ya da boş
  salesContact Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users          User[]
  employees      CompanyEmployee[]
  fleetContracts FleetContract[]
  fleetInvoices  FleetInvoice[]
  serviceRequests ServiceRequest[]
}

// ---------- Filom: filo verisi (V2-35, ADR-25, docs/FLEET.md §5) ----------
// Uzun dönem filo araçları kiralık `Vehicle`'dan ayrı tablodadır; müsaitlik ve arama kodu bunları hiç görmez. Her tabloda `companyId` vardır ve
// bileşik yabancı anahtarlarla üst kaydın şirketine bağlıdır: bir şirketin kaydı başka şirketin kaydına bağlanamaz (veritabanı reddeder).

enum FleetContractStatus {
  ACTIVE
  ENDED
}

enum FleetVehicleStatus {
  ACTIVE
  RETURNED
}

enum ReadingSource {
  MANUAL
  SEED
}

enum FleetExpenseType {
  HGS
  PENALTY
  MAINTENANCE
  OTHER
}

// OPEN → REFLECTED (charged to the employee) or DISPUTED (the customer objects); DISPUTED → OPEN again. REFLECTED is final.
enum FleetExpenseStatus {
  OPEN
  REFLECTED
  DISPUTED
}

// Şirketin personeli (zimmet alan kişiler). Silinmez, `active: false` olur. Ehliyet bilgisi saklanmaz (KVKK, FLEET.md §6).
model CompanyEmployee {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  firstName  String
  lastName   String
  department String?
  employeeNo String?
  email      String?
  phone      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignments VehicleAssignment[]

  @@unique([id, companyId])
  // Aynı şirkette aynı sicil no iki kişide olmaz (boş sicil no kısıtlanmaz).
  @@unique([companyId, employeeNo])
  @@index([companyId, active])
}

// Uzun dönem filo sözleşmesi. Numara `SZL-<yıl>-<5 hane>`, bir veritabanı sequence'inden gelir. Tutarlar TRY kuruş.
// CHECK: `endAt > startAt`, `monthlyFee > 0` (migration'da).
model FleetContract {
  id           String              @id @default(uuid())
  number       String              @unique
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  productId    String
  product      Product             @relation(fields: [productId], references: [id])
  startAt      DateTime            @db.Date
  endAt        DateTime            @db.Date
  monthlyFee   Int
  deliveryCity String
  status       FleetContractStatus @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  vehicles FleetVehicle[]

  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([productId])
}

// Filo aracı. Plaka benzersizdir ve kiralık `Vehicle` plakalarıyla da çakışmaz (ikincisi servis denetimidir).
model FleetVehicle {
  id                String             @id @default(uuid())
  contractId        String
  companyId         String
  contract          FleetContract      @relation(fields: [contractId, companyId], references: [id, companyId], onDelete: Restrict)
  vehicleModelId    String
  vehicleModel      VehicleModel       @relation(fields: [vehicleModelId], references: [id])
  plate             String             @unique
  year              Int
  startKm           Int
  nextMaintenanceOn DateTime?          @db.Date
  inspectionDueOn   DateTime?          @db.Date
  status            FleetVehicleStatus @default(ACTIVE)
  returnedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  assignments VehicleAssignment[]
  readings    VehicleReading[]
  expenses    FleetExpense[]
  serviceRequests ServiceRequest[]

  @@unique([id, companyId])
  @@index([contractId])
  @@index([companyId, status])
  @@index([vehicleModelId])
}

// Zimmet: bir araç bir personelde. `endedAt` boşsa açıktır; araç başına en çok bir açık zimmet olur (migration'daki kısmi benzersiz indeks,
// `VehicleAssignment_open_vehicle_key`). Araç ve personel aynı şirkettendir (bileşik yabancı anahtarlar).
model VehicleAssignment {
  id             String          @id @default(uuid())
  companyId      String
  fleetVehicleId String
  vehicle        FleetVehicle    @relation(fields: [fleetVehicleId, companyId], references: [id, companyId], onDelete: Restrict)
  employeeId     String
  employee       CompanyEmployee @relation(fields: [employeeId, companyId], references: [id, companyId], onDelete: Restrict)
  startedAt      DateTime
  endedAt        DateTime?
  note           String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([fleetVehicleId, startedAt])
  @@index([employeeId])
  @@index([companyId])
}

// Okuma: Novera'nın girdiği km, yakıt, şarj ve batarya sağlığı. Yüzdeler 0–100 (CHECK, migration'da).
model VehicleReading {
  id                   String        @id @default(uuid())
  fleetVehicleId       String
  vehicle              FleetVehicle  @relation(fields: [fleetVehicleId], references: [id], onDelete: Restrict)
  at                   DateTime      @default(now())
  km                   Int
  fuelPercent          Int?
  chargePercent        Int?
  batteryHealthPercent Int?
  source               ReadingSource @default(MANUAL)
  createdAt            DateTime      @default(now())

  @@index([fleetVehicleId, at])
}

// Aylık filo faturası (V2-37, docs/FLEET.md §5, docs/ADMIN.md §3.15): bir şirketin bir dönemi için tek fatura. Numara
// `FTR-<yıl>-<5 hane>`, `FleetInvoiceNumber_seq` sequence'inden gelir. Satırlar sözleşme başınadır (JSON: sözleşme numarası, ürün,
// gün sayısı, ayın gün sayısı, tutar); ara toplam satırların toplamıdır, KDV ara toplamın %20'si, toplam ikisinin toplamıdır (CHECK ile de
// korunur). Tutarlar TRY kuruş. "Gecikti" saklanmaz: ödenmemiş ve son ödeme günü geçmiş fatura sorgu anında gecikmiş sayılır.
model FleetInvoice {
  id        String   @id @default(uuid())
  number    String   @unique
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // "2026-10": faturanın ait olduğu ay.
  period    String
  issuedAt  DateTime @db.Date
  dueAt     DateTime @db.Date
  lines     Json
  subtotal  Int
  vat       Int
  total     Int
  // Boşsa ödenmemiş.
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Bir şirketin bir dönemi için tek fatura: aynı dönemi iki kez üretmeye çalışan ikinci istek veritabanında da durur.
  @@unique([companyId, period])
  @@index([period])
  @@index([companyId, issuedAt])
}

// Filo masrafı (V2-38, docs/FLEET.md §5): HGS geçişi, ceza, bakım ya da başka bir gider; Novera plakayla girer. Tutar TRY kuruş (CHECK > 0).
// Masrafın personeli SAKLANMAZ: `occurredAt` anında aracın açık zimmeti kimdeyse odur, sorgu anında hesaplanır (ADR-25). Araç ve şirket
// bileşik yabancı anahtarla bağlıdır: bir şirketin masrafı başka şirketin aracına yazılamaz.
model FleetExpense {
  id             String             @id @default(uuid())
  companyId      String
  fleetVehicleId String
  vehicle        FleetVehicle       @relation(fields: [fleetVehicleId, companyId], references: [id, companyId], onDelete: Restrict)
  type           FleetExpenseType
  occurredAt     DateTime
  amount         Int
  description    String?
  place          String?
  status         FleetExpenseStatus @default(OPEN)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([companyId, occurredAt])
  @@index([companyId, status])
  @@index([fleetVehicleId, occurredAt])
}

// Kurgusal şarj istasyonu (V2-40, ADR-30, docs/FLEET.md §3.1): ad, şehir, konum ve soket türleri seed'de sabittir. Müsaitlik (müsait, dolu,
// arızalı) SAKLANMAZ: istasyon kimliği ve 5 dakikalık dilimden deterministik üretilir (`src/fleet/simulation/`). Bir şehirde aynı ad iki kez olmaz.
model ChargingStation {
  id        String   @id @default(uuid())
  name      String
  city      String
  latitude  Float
  longitude Float
  // "CCS", "CHAdeMO", "TYPE2" ... en az bir tane (migration'daki CHECK).
  sockets   String[]
  createdAt DateTime @default(now())

  @@unique([city, name])
  @@index([city])
}

// ---------- Servis talepleri (V2-41, ADR-31, docs/FLEET.md §3, SPEC §3.D) ----------
// Tek tablo, türe göre ayrıntı: `details` her tür için ayrı bir zod şemasıyla doğrulanır (src/fleet/requests/request-details.ts), durum geçişleri tür
// başına bir tabloda tanımlıdır (request-flow.ts). Tek durum listesi tüm türlerin adımlarını taşır; hangi türün hangi adımları kullanabildiği
// migration'daki CHECK ile de korunur.

enum ServiceRequestType {
  ROADSIDE
  REPLACEMENT_VEHICLE
  MAINTENANCE
  // V2-42: yalnızca etkin `vip-mobilite` sözleşmesi olan şirkette açılır.
  TRANSFER
}

enum ServiceRequestStatus {
  RECEIVED
  // Yol yardım: Yönlendirildi → Yolda → Tamamlandı
  DISPATCHED
  EN_ROUTE
  // İkame araç: Onaylandı → Teslim edildi → İade alındı
  APPROVED
  DELIVERED
  RETURNED
  // Bakım ve lastik: Randevu verildi → Serviste → Tamamlandı
  SCHEDULED
  IN_SERVICE
  // VIP transfer: Şoför atandı → Karşılandı → Tamamlandı
  DRIVER_ASSIGNED
  MET
  COMPLETED
  CANCELLED
}

// Olayı kimin yaptığı: şirketin kendi hesabı mı, Novera mı. Kişinin adı müşteriye ve yöneticiye gösterilmez, bu iki söz yeter.
enum ServiceRequestActor {
  COMPANY
  NOVERA
}

model ServiceRequest {
  id          String               @id @default(uuid())
  // `TLP-<yıl>-<5 hane>`, `ServiceRequestNumber_seq` sequence'inden gelir.
  number      String               @unique
  companyId   String
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdById String?
  createdBy   User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  type        ServiceRequestType
  status      ServiceRequestStatus @default(RECEIVED)
  // Transfer dışındaki her türde dolu (CHECK). Aracın şirketin olması bir tetikleyiciyle de korunur (migration).
  fleetVehicleId String?
  vehicle        FleetVehicle?     @relation(fields: [fleetVehicleId], references: [id], onDelete: Restrict)
  details     Json
  // Yöneticinin girdiği serbest metin: çekici, servis ya da şoför bilgisi (gerçek tedarikçi entegrasyonu yok).
  assignee    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  events ServiceRequestEvent[]

  @@index([companyId, createdAt])
  @@index([status])
  @@index([fleetVehicleId])
}

// Talebin zaman çizelgesi: her durum değişikliği bir satır. Yalnızca eklenir.
model ServiceRequestEvent {
  id        String               @id @default(uuid())
  requestId String
  request   ServiceRequest       @relation(fields: [requestId], references: [id], onDelete: Restrict)
  status    ServiceRequestStatus
  note      String?
  actor     ServiceRequestActor
  // Kimin yaptığı kişisel veri olmasın diye yabancı anahtar değildir; hesap silinse de olay kalır.
  actorId   String?
  at        DateTime             @default(now())

  @@index([requestId, at])
}

// Yönetimde değiştiren her işlemin kaydı (V2-23, ADR-24). Yalnızca eklenir: servis güncelleme ya da silme sunmaz ve
// veritabanı tetikleyicisi UPDATE/DELETE'i reddeder. Değer ve kişisel veri yazılmaz, yalnızca değişen alanların adları.
// `actorId` bilerek yabancı anahtar değildir: hesap silinse de kayıt kalır. Komut satırı işlemleri `cli` yazar.
model AuditLog {
  id        String   @id @default(uuid())
  at        DateTime @default(now())
  actorId   String
  companyId String?
  // Nokta ile: `admin.ping`, `branch.close` ...
  action    String
  entity    String
  entityId  String?
  fields    String[]

  @@index([at])
  @@index([actorId, at])
  @@index([entity, entityId])
}

// Giriş oturumu (BACKLOG #34). Çerezdeki rastgele anahtarın yalnızca SHA-256 özeti saklanır.
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String? // girişte tarayıcının bildirdiği; "açık oturumlar" listesinde cihaz adı için
  createdAt DateTime @default(now())
  // Son kullanım (V2-10): en çok 5 dakikada bir güncellenir; 7 gün kullanılmayan oturum geçersizdir.
  lastUsedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Sign-in attempts that failed, per e-mail address (V2-10, QUALITY G-15). After a few failures the address has to wait,
// 1, 2, 4 ... at most 15 minutes, instead of being locked; the same for an address with no account, so the wait
// does not tell whether the account exists. A correct sign-in clears it; old rows are deleted by the daily task.
model LoginThrottle {
  email       String    @id
  failures    Int
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// Single-use password reset link (BACKLOG #27, issue #36). Only the SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  // Unutulan şifre mi, kurumsal davet mi (V2-33): süre ve e-posta metni buna göre değişir.
  kind      ResetTokenKind @default(RESET)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Counters of the rate limit (ARCHITECTURE ADR-27). One row per key, bucket (a group of endpoints) and fixed
// time window; a request adds one with a single `INSERT … ON CONFLICT … DO UPDATE`, so concurrent requests are
// counted exactly. A daily task deletes the old windows. `key` is `user:<id>` or `ip:<hash of the address>`
// (never the address itself), or an `email:<address>` for the sign-in and reset limits.
model RateLimitHit {
  key         String
  bucket      String
  windowStart DateTime
  count       Int

  @@id([key, bucket, windowStart])
}

// Puan kazanımı. Bakiye = bu kayıtların toplamı. Harcanan puan ayrı bir defterde değil `Reservation.pointsUsed`'da tutulur (QUALITY V-08, V2-11'de bilerek bu şekilde bırakıldı).
model PointTransaction {
  id        String   @id @default(uuid())
  points    Int
  createdAt DateTime @default(now())

  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ---------- Bayi ve araç ----------

// A branch is an airport desk or a city office (V2-27); it was read from the name before.
enum BranchKind {
  CITY
  AIRPORT
}

model Branch {
  id           String @id @default(uuid())
  name         String
  city         String
  address      String
  latitude     Float
  longitude    Float
  phone        String
  email        String
  openingHours Json
  kind         BranchKind @default(CITY)
  // Set when the branch is closed from the panel (V2-27): it is left out of the site and cannot be booked. Never deleted:
  // past bookings keep its name. Empty means open.
  closedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicles       Vehicle[]
  pickupBookings Reservation[] @relation("PickupBranch")
  returnBookings Reservation[] @relation("ReturnBranch")
  pickupHolds    Hold[]        @relation("HoldPickupBranch")
  returnHolds    Hold[]        @relation("HoldReturnBranch")

  @@index([city])
  @@index([closedAt])
}

model VehicleClass {
  id     String @id @default(uuid())
  slug   String @unique
  nameTr String
  nameEn String

  models VehicleModel[]
}

// Katalogdaki model (Araçlarımız sayfası). Fiyat ve özellikler burada.
model VehicleModel {
  id              String          @id @default(uuid())
  slug            String          @unique
  brand           String
  model           String
  seats           Int
  bags            Int
  transmission    Transmission
  fuelType        FuelType
  consumption     Float
  consumptionUnit ConsumptionUnit
  dailyPrice      Int // TRY, kuruş cinsinden (₺1.250 = 125000)
  description     Json // { "tr": "...", "en": "..." }
  imageUrl        String?
  // Set when the model is taken off the site from the panel (V2-29): it is left out of the fleet, the search and new bookings, and its
  // cars are switched off. Never deleted: past bookings keep showing it. Empty means on the site.
  retiredAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  classId String
  class   VehicleClass @relation(fields: [classId], references: [id])

  vehicles      Vehicle[]
  fleetVehicles FleetVehicle[]

  @@index([classId])
  @@index([retiredAt])
}

// Bir bayide duran fiziksel araç. Müsaitlik bu tabloya göre hesaplanır.
model Vehicle {
  id     String  @id @default(uuid())
  plate  String  @unique
  year   Int
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleModelId String
  vehicleModel   VehicleModel @relation(fields: [vehicleModelId], references: [id])
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])

  reservations Reservation[]
  holds        Hold[]

  @@index([vehicleModelId])
  @@index([branchId])
}

model Extra {
  id      String       @id @default(uuid())
  slug    String       @unique
  nameTr  String
  nameEn  String
  price   Int // TRY, kuruş cinsinden
  pricing ExtraPricing
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservationExtras ReservationExtra[]
}

// ---------- Rezervasyon ----------

// "Kirala"da aracı 15 dakika tutar. Süre dolunca araç serbest kalır;
// tutulan araç başka aramada müsait görünmez (BACKLOG Y48).
model Hold {
  id             String   @id @default(uuid())
  startAt        DateTime
  endAt          DateTime
  expiresAt      DateTime
  clientKey      String?
  createdAt      DateTime @default(now())

  vehicleId      String
  vehicle        Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  pickupBranchId String
  pickupBranch   Branch  @relation("HoldPickupBranch", fields: [pickupBranchId], references: [id])
  returnBranchId String
  returnBranch   Branch  @relation("HoldReturnBranch", fields: [returnBranchId], references: [id])

  @@index([vehicleId, startAt, endAt])
  @@index([expiresAt])
  @@index([clientKey, expiresAt])
  @@index([pickupBranchId])
  @@index([returnBranchId])
}

model Reservation {
  id      String            @id @default(uuid())
  number  String            @unique // ör. NVR-2026-00123
  status  ReservationStatus @default(CONFIRMED)
  startAt DateTime
  endAt   DateTime
  days    Int
  pointsUsed        Int      @default(0) // puanla ödenen kısım (1 puan = ₺5, yalnızca TRY); iptalde iade sayılır
  // Kampanya kodu: kod ve yüzde, rezervasyon anındaki haliyle saklanır (kod sonradan değişse de bu rezervasyon aynı kalır).
  promoCode         String?
  promoPercent      Int?
  discountAmount    Int      @default(0) // kodun düştüğü tutar, `currency` biriminin alt biriminde

  // Aşağıdaki tüm tutarlar `currency` biriminin alt biriminde (kuruş/cent) saklanır.
  // Birim fiyatlar önce çevrilir, sonra günle çarpılır: kalemlerin toplamı = totalPrice.
  currency          Currency @default(TRY)
  exchangeRate      Decimal  @default(1) @db.Decimal(18, 8) // rezervasyon anındaki kur (1 TRY = ? currency)
  vehicleDailyPrice Int
  totalPrice        Int

  createdAt   DateTime  @default(now())
  // Paneldeki çakışma denetimi (ADR-24) `updatedAt`'e bakar; iptal zamanı `cancelledAt`'te durur.
  updatedAt   DateTime  @updatedAt
  cancelledAt DateTime?
  // Panelden iptalde zorunlu neden (5-500 karakter, CHECK ile de korunur) ve iptal eden yönetici (V2-31). Müşterinin kendi iptalinde boş kalır;
  // yönetici hesabı silinirse bağlantı boşalır, neden kalır.
  cancelReason  String?
  // Seyahat hatırlatma e-postasının gönderildiği an (V2-44): dolu ise bir daha gönderilmez. Gönderimden ÖNCE tek bir koşullu güncellemeyle
  // alınır (`reminderSentAt IS NULL`), bu yüzden iki görev ya da yeniden başlayan bir örnek aynı rezervasyona iki kez yollayamaz.
  reminderSentAt DateTime?
  cancelledById String?
  cancelledBy   User?     @relation("ReservationCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)

  // Hesap silinince rezervasyon kalır, kullanıcı bağlantısı boşalır
  userId         String?
  user           User?   @relation("ReservationOwner", fields: [userId], references: [id], onDelete: SetNull)
  vehicleId      String
  vehicle        Vehicle @relation(fields: [vehicleId], references: [id])
  pickupBranchId String
  pickupBranch   Branch  @relation("PickupBranch", fields: [pickupBranchId], references: [id])
  returnBranchId String
  returnBranch   Branch  @relation("ReturnBranch", fields: [returnBranchId], references: [id])

  extras           ReservationExtra[]
  pointTransaction PointTransaction?

  @@index([vehicleId, startAt, endAt])
  // Hatırlatma görevi: başlangıcı yakın, onaylı ve henüz hatırlatılmamış rezervasyonları arar (V2-44).
  @@index([status, startAt])
  // Rezervasyonlarım: bir hesabın rezervasyonları başlangıca göre sıralı okunur.
  // `(userId, startAt)` aynı zamanda yalnızca `userId` ile aramayı da karşılar; ayrı bir `userId` indeksi gerekmez.
  @@index([userId, startAt])
  @@index([pickupBranchId])
  @@index([returnBranchId])
  // Kampanya kodu kullanım sayımı (V2-05): kod başına ve kişi başına.
  @@index([promoCode, status])
}

// Kampanya kodları (SPEC §2.3): araç ve ek hizmetlerin toplamından yüzde olarak düşer.
// Kod büyük harfle saklanır; aranırken de büyük harfe çevrilir.
// Kullanım sayısı ayrı bir sütunda tutulmaz: iptal edilmemiş (CONFIRMED) rezervasyonlardan sayılır, böylece
// iptal edilen rezervasyonun kodu kendiliğinden geri döner (V2-05).
model PromoCode {
  id             String    @id @default(uuid())
  code           String    @unique
  percent        Int // 1-90 arası tam sayı; veritabanında CHECK ile de korunur (migration 20261025120000)
  active         Boolean   @default(true)
  validFrom      DateTime? // boşsa hemen geçerli
  validUntil     DateTime? // boşsa süresiz
  maxRedemptions Int? // toplam kullanım tavanı (en az 1; CHECK); boşsa sınırsız
  oncePerUser    Boolean   @default(true) // aynı kişi kodu bir kez kullanabilir
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ReservationExtra {
  id         String @id @default(uuid())
  quantity   Int    @default(1)
  unitPrice  Int // rezervasyon anındaki fiyat, rezervasyonun para biriminde
  totalPrice Int

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  extraId       String
  extra         Extra       @relation(fields: [extraId], references: [id])

  @@unique([reservationId, extraId])
  @@index([extraId])
}

// ---------- İçerik ve formlar ----------

// Kurumsal ürünler yalnızca bir referanstır: `QuoteRequest.productId` buna bağlanır. Metinlerin tek kaynağı web'in
// çeviri dosyalarıdır (`messages/*/products.json`, ADR-32); slug'lar `apps/web/lib/products.ts` ile aynı olmalı.
model Product {
  id   String @id @default(uuid())
  slug String @unique // ör. akilli-kurumsal-filo

  quotes         QuoteRequest[]
  fleetContracts FleetContract[]
}

// Kurumsal teklif talepleri (GET /me/quotes ve POST /quotes)
model QuoteRequest {
  id             String      @id @default(uuid())
  number         String      @unique // ör. TKL-2026-00042
  status         QuoteStatus @default(RECEIVED)
  source         QuoteSource @default(WEB)
  companyName    String
  contactName    String?
  phone          String?
  vehicleCount   Int
  durationMonths Int
  vehicleType    String
  deliveryCities String?
  notes          String?
  email          String
  kvkkConsentAt  DateTime    @default(now())
  createdAt      DateTime    @default(now())
  // Teklifin durumu değiştikçe güncellenir; panelin çakışma denetimi (ADR-24) bunu kullanır.
  updatedAt      DateTime    @updatedAt
  // Yalnızca çalışanın okuduğu not (en çok 2000 karakter, CHECK ile de korunur). Müşteriye giden hiçbir cevapta yoktur (V2-32).
  internalNote   String?
  // Kişisel alanlar (ad, e-posta, telefon, notlar) silindiğinde dolar: saklama süresi dolunca ya da hesap silinince (V2-12).
  anonymizedAt   DateTime?

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}

model ContactMessage {
  id            String   @id @default(uuid())
  name          String
  email         String
  phone         String?
  subject       String
  message       String
  kvkkConsentAt DateTime
  createdAt     DateTime @default(now())
  // Saklama süresi dolunca ad, e-posta, telefon ve mesaj silinir; konu ve tarih istatistik için kalır (V2-12).
  anonymizedAt  DateTime?
  // "Ele alındı" işareti: ne zaman ve hangi yönetici. Geri alınabilir (ikisi de boşalır). Yönetici hesabı silinirse bağlantı boşalır (V2-32).
  handledAt     DateTime?
  handledById   String?
  handledBy     User?     @relation("MessageHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([handledAt])
}

model ExchangeRate {
  currency   Currency @id
  ratePerTry Decimal  @db.Decimal(18, 8) // 1 TRY kaç `currency` ediyor
  updatedAt  DateTime @updatedAt
}
// A rate from the feed that moved too far from the stored one (V2-13, QUALITY V-10). A big move is held back as a candidate;
// when the feed keeps saying the same thing on the third day it is accepted, so a real devaluation cannot lock the rates.
// `since` is when the candidate first came; it is kept apart from ExchangeRate so `updatedAt` there still means "last stored".
model RateCandidate {
  currency   Currency @id
  ratePerTry Decimal  @db.Decimal(18, 8)
  since      DateTime
}
